        "rotary": [
            {"pin_a": "GP14", "pin_b": "GP15", "resolution": 4}
        ]
    },
    "dip_switch": {
        "enabled": true,
        "pins": ["GP26"]
    },
    "usb": {
        "vid": "0xFEED",
        "pid": "0x2040",
        "device_version": "1.0.0"
    },
